[Unit]
Description=Server Donation Dashboard
After=network.target

[Service]
Type=simple
User=serverdonation
Group=serverdonation
WorkingDirectory=/opt/server-donation
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/server-donation/venv/bin/python /opt/server-donation/app.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
